# LuceBien · ejemplo de .env
# Copia este archivo como .env y completa los valores reales.
# .env NO debe commitearse — está en .gitignore.

# Secret de firma JWT. CAMBIAR en producción a una cadena aleatoria
# de al menos 32 caracteres. Si se omite, el código usa un default
# hardcodeado (NO seguro para producción).
JWT_SECRET=cambia-este-valor-en-produccion-min-32-chars

# Puerto HTTP del servidor Express
PORT=3000

# ── Backups automáticos de la BD ────────────────────────────────
# Frecuencia en horas del backup automático (default 24).
BACKUP_INTERVAL_HOURS=24
# Cantidad máxima de backups a conservar antes de rotar (default 14).
BACKUP_MAX_KEEP=14

# ── Reporte semanal automatizado (tools/weekly-report) ──────────
# API key de Claude (Anthropic). EL COMITENTE paga el plan Claude 5x MAX per Cl. 11ma.
ANTHROPIC_API_KEY=sk-ant-...

# SMTP para envío del reporte al cliente. Usar Gmail con App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=imalexandre05@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Correo del REVISOR (tu propio email). El draft del reporte llega aquí.
# Vos lo revisás y, si está OK, lo reenviás manualmente al cliente desde Gmail.
# NUNCA el script envía directo al cliente — protección legal contra errores de IA.
REPORT_REVIEWER=imalexandre05@gmail.com

# Para probar sin enviar correo, descomentar:
# REPORT_DRY_RUN=true
