# ═══════════════════════════════════════════════════════════════════════════════════════════
# Colector del huellero — plantilla de configuración
#
# Copiar este archivo como `.env` en esta misma carpeta y completar los valores. El `.env` real
# NUNCA entra al repo: está ignorado en el .gitignore de la raíz.
#
# La contraseña del huellero vive únicamente acá. No está en la base de datos ni en el código.
# ═══════════════════════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────────────────────
# La URL del proyecto y la clave PÚBLICA (anon). La service key NO se usa acá ni en ningún lado
# fuera del servidor: el colector se autentica como un usuario común con permisos mínimos.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Usuario del colector ───────────────────────────────────────────────────────────────────
# Cuenta propia de Supabase, creada para esta PC, con su uid registrado en la tabla
# `huellero_colectores`. No es administrador ni empleado: lo único que puede hacer es insertar
# marcas de asistencia.
COLECTOR_CORREO=
COLECTOR_CONTRASENA=

# ── Equipos ────────────────────────────────────────────────────────────────────────────────
# Lista de nombres separados por coma. Cada nombre necesita sus tres variables ID_, IP_ y PASS_.
# Agregar un segundo huellero es agregar el nombre acá y sus tres líneas abajo.
EQUIPOS=ALMACEN

# El uuid de la fila del equipo en la tabla `dispositivos_huellero`.
ID_ALMACEN=
IP_ALMACEN=192.168.1.220
# Usuario de administración del terminal. Casi siempre `admin`.
USUARIO_ALMACEN=admin
# La MISMA contraseña con la que se entra a https://192.168.1.220 desde el navegador.
PASS_ALMACEN=
# Poner en true sólo si el equipo no responde por HTTPS.
HTTP_ALMACEN=false
# Sólo si el equipo no está en el puerto de siempre (443 con HTTPS, 80 con HTTP). Vacío = el de
# siempre, que es el caso del equipo del almacén.
# PUERTO_ALMACEN=

# ── Ritmo ──────────────────────────────────────────────────────────────────────────────────
# Cada cuántos minutos se consulta al equipo.
INTERVALO_MINUTOS=5
# Cuánto se retrocede sobre el checkpoint en cada consulta. Repetir no duplica nada: la RPC es
# idempotente por (dispositivo, número de serie del evento).
SOLAPE_MINUTOS=10
# Desde dónde empieza la primera corrida, cuando el equipo todavía no tiene ninguna marca en la
# base. Decisión del dueño del proyecto: el histórico se trae desde el 1 de enero de 2026.
INICIO_HISTORICO=2026-01-01
