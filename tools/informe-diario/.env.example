# Copiar a .env y completar. El archivo .env NO se versiona.

# Cuenta desde la que sale el correo y su contraseña de aplicación de Google
# (16 letras, generada en myaccount.google.com/apppasswords — no es la contraseña
# normal de la cuenta, y se puede revocar sin cambiar nada más).
SMTP_USER=correo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# A quién llega el informe y quién queda en copia.
DESTINATARIO=destino@gmail.com
CC=correo@gmail.com

# Carpetas locales.
BORRADORES_DIR=E:\Lucebien informes\borradores
INFORMES_DIR=E:\Lucebien informes

# Carpeta de Google Drive para escritorio donde el dueño ve los informes.
DRIVE_DIR=H:\Mi unidad\...\INFORMES DE ALEX
